{
  "name": "@worldcoin/idkit-core",
  "version": "4.3.0",
  "description": "Portable TypeScript SDK for World ID",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/idkit.global.js",
  "jsdelivr": "./dist/idkit.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "node": {
        "import": "./dist/node.js",
        "require": "./dist/node.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "import": "./dist/signing.js",
      "require": "./dist/signing.cjs"
    },
    "./hashing": {
      "types": "./dist/hashing.d.ts",
      "import": "./dist/hashing.js",
      "require": "./dist/hashing.cjs"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js",
      "require": "./dist/session.cjs"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "import": "./dist/expo.js",
      "require": "./dist/expo.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "signing": [
        "./dist/signing.d.ts"
      ],
      "hashing": [
        "./dist/hashing.d.ts"
      ],
      "session": [
        "./dist/session.d.ts"
      ],
      "expo": [
        "./dist/expo.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:ts": "tsup",
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "worldcoin",
    "world-id",
    "idkit",
    "identity",
    "proof-of-personhood",
    "zero-knowledge"
  ],
  "author": "Tools for Humanity",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/worldcoin/idkit"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "^1.7.2",
    "@scure/base": "1.2.6",
    "@stablelib/utf8": "1.0.2",
    "@worldcoin/idkit-server": "workspace:*",
    "whatwg-url": "14.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@vitest/coverage-v8": "^4.0.18",
    "fast-check": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "expo-crypto": "57.0.3"
  },
  "peerDependencies": {
    "expo-crypto": "^57.0.3"
  },
  "peerDependenciesMeta": {
    "expo-crypto": {
      "optional": true
    }
  }
}
